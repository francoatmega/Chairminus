// Seed for the default "neo4j" database: the shop graph, recovered from the original test environment.
// Labels: Categoria, Cliente (some also Vip), Produto, Pedido.
// Relationship types: FEZ, CONTEM, AVALIOU, INDICOU, NA_CATEGORIA.

CREATE CONSTRAINT `categoria_nome` IF NOT EXISTS FOR (n:`Categoria`) REQUIRE (n.`nome`) IS UNIQUE;
CREATE CONSTRAINT `cliente_email` IF NOT EXISTS FOR (n:`Cliente`) REQUIRE (n.`email`) IS UNIQUE;
CREATE CONSTRAINT `cliente_id` IF NOT EXISTS FOR (n:`Cliente`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `pedido_numero` IF NOT EXISTS FOR (n:`Pedido`) REQUIRE (n.`numero`) IS UNIQUE;
CREATE CONSTRAINT `produto_sku` IF NOT EXISTS FOR (n:`Produto`) REQUIRE (n.`sku`) IS UNIQUE;
CREATE RANGE INDEX `cliente_cidade` IF NOT EXISTS FOR (n:`Cliente`) ON (n.`uf`, n.`cidade`);
CREATE RANGE INDEX `pedido_status` IF NOT EXISTS FOR (n:`Pedido`) ON (n.`status`);

UNWIND [
  {nome: 'Cadeiras', descricao: 'Cadeiras de escritório, de jantar e banquetas'},
  {nome: 'Decoração', descricao: 'Tapetes, espelhos e objetos'},
  {nome: 'Escritório', descricao: 'Organização e acessórios de trabalho'},
  {nome: 'Estantes', descricao: 'Estantes, prateleiras e nichos'},
  {nome: 'Iluminação', descricao: 'Luminárias, pendentes e abajures'},
  {nome: 'Jardim', descricao: 'Móveis e acessórios para área externa'},
  {nome: 'Mesas', descricao: 'Mesas de trabalho, de jantar e de apoio'},
  {nome: 'Sofás', descricao: 'Sofás, poltronas e pufes'}
] AS linha
CREATE (n:Categoria) SET n = linha;

